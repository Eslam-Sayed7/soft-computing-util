<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
    
	<groupId>com.example</groupId>
	<artifactId>soft-util</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>soft-util</name>
	<description>soft-computing utilities for soft computing techniques</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<maven.compiler.source>17</maven.compiler.source>
		<maven.compiler.target>17</maven.compiler.target>
		<java.version>17</java.version>
	</properties>
	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<version>3.11.0</version>
				<configuration>
					<source>${maven.compiler.source}</source>
					<target>${maven.compiler.target}</target>
				</configuration>
			</plugin>

			<!-- Optional: produce an executable jar -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-shade-plugin</artifactId>
				<version>3.5.0</version>
				<executions>
					<execution>
						<phase>package</phase>
						<goals>
							<goal>shade</goal>
						</goals>
						<configuration>
							<createDependencyReducedPom>false</createDependencyReducedPom>
							<transformers>
								<transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
									<mainClass>softcomputing.genetic.SoftUtilApplication</mainClass>
								</transformer>
							</transformers>
						</configuration>
					</execution>
				</executions>
			</plugin>

		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-surefire-plugin</artifactId>
			<version>3.1.2</version>
			<configuration>
				<useModulePath>false</useModulePath>
			</configuration>
		</plugin>

		<!-- Javadoc plugin for generating documentation -->
		<plugin>
			<groupId>org.apache.maven.plugins</groupId>
			<artifactId>maven-javadoc-plugin</artifactId>
			<version>3.6.3</version>
			<configuration>
				<source>17</source>
				<show>public</show>
				<nodeprecated>false</nodeprecated>
				<author>true</author>
				<version>true</version>
				<use>true</use>
				<windowtitle>Soft Computing Utilities API Documentation</windowtitle>
				<doctitle><![CDATA[<h1>Soft Computing Utilities</h1>]]></doctitle>
				<bottom><![CDATA[<i>Copyright &#169; 2025. All Rights Reserved.</i>]]></bottom>
				<additionalOptions>
					<additionalOption>-html5</additionalOption>
				</additionalOptions>
				<sourceFileIncludes>
					<sourceFileInclude>com/example/softcomputing/genetic/**/*.java</sourceFileInclude>
					<sourceFileInclude>com/example/softcomputing/utils/FitnessFunction.java</sourceFileInclude>
					<sourceFileInclude>com/example/softcomputing/utils/AppLogger.java</sourceFileInclude>
					<sourceFileInclude>com/example/softcomputing/utils/InfeasibleSolution.java</sourceFileInclude>
				</sourceFileIncludes>
			</configuration>
			<executions>
				<execution>
					<id>attach-javadocs</id>
					<goals>
						<goal>jar</goal>
					</goals>
				</execution>
			</executions>
		</plugin>
	</plugins>
</build></project>
